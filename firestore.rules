rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everything stored here is encrypted on the phone with each person's password.
    // Only app clients that signed in (anonymously) may read or write.
    match /vault/{id} { allow read, write: if request.auth != null; }
    match /accts/{id}  { allow read, write: if request.auth != null; }
  }
}
