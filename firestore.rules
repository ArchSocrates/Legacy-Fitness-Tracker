rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every private document carries "o" = the Firebase uid of its owner. People can only touch their own.
    match /vault/{id} {
      allow read, delete: if request.auth != null && resource.data.o == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.o == request.auth.uid;
      allow update: if request.auth != null && resource.data.o == request.auth.uid
                    && request.resource.data.o == request.auth.uid;
    }
    match /accts/{id} {
      allow read, delete: if request.auth != null && resource.data.o == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.o == request.auth.uid;
      allow update: if request.auth != null && resource.data.o == request.auth.uid
                    && request.resource.data.o == request.auth.uid;
    }
    // Friends leaderboard (opt in). Anyone signed in can read it; you can only write your own row.
    match /board/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && id == request.auth.uid && request.resource.data.o == request.auth.uid;
      allow update: if request.auth != null && id == request.auth.uid && resource.data.o == request.auth.uid
                    && request.resource.data.o == request.auth.uid;
      allow delete: if request.auth != null && resource.data.o == request.auth.uid;
    }
  }
}
