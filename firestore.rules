rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every document carries "o" = the Firebase uid of its owner. People can only touch their own.
    match /vault/{id} {
      allow read, delete: if request.auth != null && resource.data.o == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.o == request.auth.uid;
      allow update: if request.auth != null && resource.data.o == request.auth.uid
                    && request.resource.data.o == request.auth.uid;
    }
    match /accts/{id} {
      allow read, delete: if request.auth != null && resource.data.o == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.o == request.auth.uid;
      allow update: if request.auth != null && resource.data.o == request.auth.uid
                    && request.resource.data.o == request.auth.uid;
    }
  }
}
